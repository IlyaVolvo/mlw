{
  "name": "polywordlot",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "commit": "sh scripts/commit.sh",
    "dev": "vite",
    "dev:server": "cd server && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "cd server && npm install && npm run build && cd .. && tsc && vite build",
    "build:offline": "cd server && npm install && npm run build && cd .. && tsc && VITE_OFFLINE_MODE=true vite build && bash scripts/generate-version.sh dist",
    "start:offline": "OFFLINE_MODE=true node server/dist/index.js",
    "dev:offline": "VITE_OFFLINE_MODE=true vite",
    "preview": "vite preview"
  },
  "dependencies": {
    "@prisma/client": "^7.3.0",
    "@vercel/node": "^5.5.25",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.8",
    "pg": "^8.11.3",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "prisma": "^7.3.0",
    "typescript": "^5.2.2",
    "vite": "^7.3.1"
  }
}
