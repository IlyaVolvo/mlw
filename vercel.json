{
  "version": 2,
  "buildCommand": "cd server && npm run build && cd .. && npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install && cd server && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@3.0.7"
    }
  }
}

