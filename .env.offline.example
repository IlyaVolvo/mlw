# Copy to .env.local and fill in values before running build:offline

# Enables offline mode in the frontend build (IndexedDB, no auth, SW registration)
VITE_OFFLINE_MODE=true

# URL of the server that receives anonymous analytics events and serves version.json.
# In production this is the same origin (leave empty to use relative URLs, which is the default).
# Set to a full URL only if the analytics server is on a different origin.
VITE_ANALYTICS_URL=

# Email address that receives feedback sent from the offline app (mailto: link)
VITE_FEEDBACK_EMAIL=polywordlot@example.com

# --- Server-side (used by npm run start:offline) ---
OFFLINE_MODE=true
PORT=3101

# Directory where SQLite analytics DB is stored (must be a persistent volume on Render)
DATA_DIR=/data

# Optional API key to protect the analytics read endpoints (/api/analytics/stats, /api/analytics/access)
# Leave empty to disable auth on those endpoints (fine for private deployments)
ANALYTICS_API_KEY=
