{
  "name": "polywordlot-server",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npx tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "studio": "npx prisma studio --port 5557",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "populate:games": "npx tsx scripts/populateGames.ts",
    "test:email": "npx tsx test-email.ts",
    "test:email:alt": "npx tsx test-email-alternative.ts",
    "debug:email": "npx tsx debug-smtp.ts"
  },
  "dependencies": {
    "@prisma/client": "^7.2.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.8",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9",
    "concurrently": "^9.2.1",
    "prisma": "^7.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2"
  }
}
